# ============================================
# AllinONE Gaming Platform — 环境变量模板
# 复制为 .env 并填写实际值
# ============================================

# CloudBase 环境配置
# 前端 SDK (js-sdk) 使用的环境变量
VITE_CLOUDBASE_ENV=allinonegaming-d4gmsmrzz573264f6

# CloudBase 管理端凭证（仅用于 db_init 脚本，不提交到 Git）
# 从 https://console.cloud.tencent.com/cam/capi 获取
TCB_SECRET_ID=your_secret_id_here
TCB_SECRET_KEY=your_secret_key_here

# JWT 认证密钥（生产环境必须设置 256-bit 随机值）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-256-bit-secret-here

# CORS 允许的源（逗号分隔，留空使用默认域名）
CORS_ORIGIN=https://allinonegaming-d4gmsmrzz573264f6.ap-shanghai.app.tcloudbase.com

# 数据库配置
DATABASE_URL=postgresql://user:password@host:5432/allinone_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=allinone_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# 服务器配置
NODE_ENV=development
PORT=3000
USE_MEMORY_DB=true   # 生产环境改为 false
LOG_LEVEL=info
