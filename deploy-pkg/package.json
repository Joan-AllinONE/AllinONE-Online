{
  "name": "allinone_gaming_platform",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev:client": "vite --host --port 3001",
    "dev:server": "node server.js",
    "dev": "pnpm run build:server && concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "build:client": "vite build --outDir dist/static",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build:server && pnpm run build:client",
    "setup:db": "node scripts/setup-database.js",
    "db:init": "node cloudfunctions/db_init/init.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node server.js",
    "deploy": "pnpm run build:client && gh-pages -d dist/static",
    "deploy:cloudbase": "pnpm run build:client && tcb hosting deploy dist/static -e allinonegaming-d4gmsmrzz573264f6"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^2.25.7",
    "@fortawesome/fontawesome-free": "^7.0.1",
    "@hookform/resolvers": "^3.9.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^12.9.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "mathjs": "^15.2.0",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^7.3.0",
    "recharts": "^2.15.1",
    "sonner": "^2.0.2",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudbase/node-sdk": "^3.18.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "gh-pages": "^6.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.8"
  }
}
