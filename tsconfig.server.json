{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist/server",
    "rootDir": "./src",
    "declaration": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowImportingTsExtensions": false,
    "noEmitOnError": false
  },
  "include": [
    "src/server/memoryDatabase.ts",
    "src/server/redeemCodeStore.ts",
    "src/server/auth/jwt.ts",
    "src/server/logger.ts",
    "src/server/requestId.ts",
    "src/server/metrics.ts",
    "src/server/routes/health.ts",
    "src/server/routes/redeem.ts",
    "src/server/routes/inventory.ts",
    "src/server/routes/games.ts",
    "src/server/routes/activity.ts",
    "src/server/routes/gameDeveloper.ts",
    "src/server/routes/gameWallet.ts",
    "src/server/routes/quests.ts",
    "src/server/routes/content.ts",
    "src/server/routes/contractTunnel.ts",
    "src/server/routes/notifications.ts",
    "src/server/routes/limitedEvent.ts",
    "src/server/eventEngine.ts",
    "src/contracts/index.ts",
    "src/contracts/config.ts",
    "src/contracts/types.ts",
    "src/contracts/engine/hash.ts",
    "src/contracts/engine/canonical.ts",
    "src/contracts/engine/evaluate.ts",
    "src/contracts/engine/validate.ts",
    "src/contracts/engine/execute.ts",
    "src/contracts/engine/ledger.ts",
    "src/contracts/templates/index.ts",
    "src/contracts/templates/groupBuy.ts",
    "src/contracts/templates/teamQuest.ts",
    "src/contracts/templates/gso.ts",
    "src/services/revenueSplit.ts",
    "src/server/analytics/analyticsStore.ts",
    "src/server/routes/analytics.ts",
    "src/activity/types.ts",
    "src/activity/seed/defaultActivities.ts"
  ]
}
